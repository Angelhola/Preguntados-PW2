
<h1 class="titulo-arcade">REGISTRO</h1>
<div class="tarjeta-arcade">
    <form method="post" enctype="multipart/form-data" action="index.php?controller=login&method=registrar">
        <label for="nombreCompleto">NOMBRE COMPLETO</label>
        <input type="text" id="nombreCompleto" name="nombreCompleto">

        <label for="genero">GÉNERO</label>
        <select id="genero" name="genero">
            <option value="femenino">Femenino</option>
            <option value="masculino">Masculino</option>
            <option value="otro">Otro</option>
            <option value="sin_opcion">Prefiero no decirlo</option>
        </select>

        <label for="usuario">USUARIO</label>
        <input type="text" name="usuario" id="usuario">

        <label for="email">EMAIL</label>
        <input type="email" name="email" id="email">

        <label for="buscador">CIUDAD</label>
        <div style="position:relative">
            <input type="text" id="buscador" placeholder="Empezá a escribir..." autocomplete="off">
            <div id="sugerencias" class="sugerencias-arcade"></div>
        </div>
        <input type="hidden" name="ciudad" id="ciudad">
        <input type="hidden" name="region" id="region">
        <input type="hidden" name="pais" id="pais">

        <label for="password">CONTRASEÑA</label>
        <input type="password" name="password" id="password">

        <label for="fotoPerfil">FOTO DE PERFIL</label>
        <input type="file" id="fotoPerfil" name="fotoPerfil" accept="image/*">

        <button type="submit" class="boton-arcade">REGISTRARME</button>
    </form>
    <a href="index.php?controller=login&method=show" class="link-arcade">¿YA TENÉS CUENTA? INGRESÁ</a>
</div>

<script>
    const buscador = document.getElementById('buscador');
    const lista = document.getElementById('sugerencias');
    let espera;

    buscador.addEventListener('input', () => {
        ['ciudad', 'region', 'pais'].forEach(id => document.getElementById(id).value = '');
        clearTimeout(espera);
        const texto = buscador.value.trim();
        if (texto.length < 3) { lista.style.display = 'none'; return; }

        espera = setTimeout(async () => {
            const url = 'https://photon.komoot.io/api/?limit=6&osm_tag=place&q=' + encodeURIComponent(texto);
            const datos = await (await fetch(url)).json();
            lista.innerHTML = '';

            datos.features.forEach(f => {
                const p = f.properties;
                const ciudad = p.city || p.name;
                const item = document.createElement('div');
                item.className = 'sugerencia';
                item.textContent = [ciudad, p.state, p.country].filter(Boolean).join(', ');
                item.onclick = () => {
                    buscador.value = item.textContent;
                    document.getElementById('ciudad').value = ciudad || '';
                    document.getElementById('region').value = p.state || '';
                    document.getElementById('pais').value = p.country || '';
                    lista.style.display = 'none';
                };
                lista.appendChild(item);
            });
            lista.style.display = datos.features.length ? 'block' : 'none';
        }, 400);
    });
</script>
