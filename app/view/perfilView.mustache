<a class="lobby-mini" href="?controller=evento&method=lobby">VOLVER</a>

<div class="tarjeta-arcade perfil">
    <div class="perfil-cabecera">
        <div class="perfil-avatar">?</div>
        <div>
            <h2>{{usuario}}</h2>
            <span>{{email}}</span>
            {{^verificado}}
                <button class="lobby-mini" type="submit">VERIFICAR</button>
            {{/verificado}}
        </div>
    </div>

    <h3>ESTADISTICAS</h3>
    <div>PARTIDAS: 0</div>
    <div>ACIERTOS: 0%</div>

    <h3>LOGROS</h3>
    <details>
        <summary>1 / 5 DESBLOQUEADOS</summary>
        {{#logros}}
            <div class="logro {{estado}}">{{icono}} {{nombre}}</div>
        {{/logros}}
    </details>

    <h3>COMPARTIR PERFIL</h3>
    <div id="qr"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById("qr"), {
            text: "{{urlPerfil}}",
            width: 220,
            height: 220,
            colorDark: "#000000",
            colorLight: "#ffffff"
        });
    </script>
</div>