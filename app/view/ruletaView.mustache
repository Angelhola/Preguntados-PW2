<style>
    .ruleta-contenedor { --tam: min(320px, 42vh); position: relative; width: var(--tam); height: var(--tam); margin: 32px auto 20px; border-radius: 50%; box-shadow: 8px 8px 0 #ff0055; }
    .ruleta-etiqueta { color: #0d0d0d; white-space: nowrap; line-height: 1; }
    .ruleta-centro { position: absolute; top: 50%; left: 50%; width: 24%; height: 24%; transform: translate(-50%, -50%); border-radius: 50%; background: #0d0d0d; border: 4px solid #ffe600; z-index: 1; }
    .ruleta-puntero { position: absolute; top: -18px; left: 50%; margin-left: -12px; border-left: 12px solid transparent; border-right: 12px solid transparent; border-top: 24px solid #fff; z-index: 2; }
    .ruleta { position: relative; width: 100%; height: 100%; box-sizing: border-box; border-radius: 50%; border: 6px solid #fff; box-shadow: none; transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 1); }
</style>

<div class="lobby-barra">
    <span class="subtitulo-arcade" style="margin:0">PUNTOS: {{puntos}}</span>
    <a class="lobby-mini" href="evento/lobby">VOLVER</a>
</div>

<p class="subtitulo-arcade">PLAYER: {{usuario}}</p>
<h1 class="titulo-arcade">RULETA</h1>

<div class="ruleta-contenedor">
    <div class="ruleta-puntero"></div>
    <div class="ruleta" id="ruleta"></div>
    <div class="ruleta-centro"></div>
</div>

<ul id="categorias" hidden>
    {{#categorias}}
        <li data-nombre="{{nombre}}" data-color="{{color}}"></li>
    {{/categorias}}
</ul>

<button id="girar" class="boton-arcade">GIRAR</button>
<button id="sonido" class="lobby-mini" type="button">🔊 SONIDO</button>
<p id="resultado" class="subtitulo-arcade" style="margin: 28px 0 0"></p>

<!-- 1) El archivo de sonidos va ANTES del script principal -->
<script src="public/js/sonidos.js"></script>
<script>
    const ruleta = document.getElementById("ruleta");
    const items = document.querySelectorAll("#categorias li");
    const boton = document.getElementById("girar");
    const resultado = document.getElementById("resultado");
    const seg = 360 / items.length;
    let giroActual = 0;
    let girando = false;

    const radio = ruleta.clientWidth / 2;
    const inicio = radio * 0.3;
    const largo = radio * 0.7 - 12;

    const partes = [];
    items.forEach(function (li, i) {
        partes.push("#0d0d0d " + i * seg + "deg " + (i * seg + 1.5) + "deg");
        partes.push(li.dataset.color + " " + (i * seg + 1.5) + "deg " + (i + 1) * seg + "deg");

        const centro = i * seg + seg / 2;
        const izquierda = centro > 180;
        const etiqueta = document.createElement("div");
        etiqueta.className = "ruleta-etiqueta";
        etiqueta.textContent = li.dataset.nombre;

        const giro = izquierda
                ? "rotate(" + (centro + 90) + "deg) translate(" + -(inicio + largo) + "px, -50%)"
                : "rotate(" + (centro - 90) + "deg) translate(" + inicio + "px, -50%)";
        etiqueta.style.cssText =
                "position:absolute; top:50%; left:50%; right:auto; bottom:auto; height:auto; margin:0; padding:0; transform-origin:0 0;" +
                "width:" + largo + "px;" +
                "font-size:" + Math.min(11, largo / li.dataset.nombre.length) + "px;" +
                "text-align:" + (izquierda ? "left" : "right") + ";" +
                "transform:" + giro + ";";
        ruleta.appendChild(etiqueta);
    });
    ruleta.style.background = "conic-gradient(" + partes.join(", ") + ")";

    // 2) NUEVO: tic cada vez que un gajo pasa por el puntero
    let frame = null;
    let ultimoGajo = -1;

    function seguirRuleta() {
        const matriz = getComputedStyle(ruleta).transform;
        if (matriz && matriz !== "none") {
            const v = matriz.match(/matrix\(([^)]+)\)/)[1].split(",").map(Number);
            const grados = (Math.atan2(v[1], v[0]) * 180 / Math.PI + 360) % 360;
            const gajo = Math.floor(((360 - grados) % 360) / seg);
            if (gajo !== ultimoGajo) {
                if (ultimoGajo !== -1) {
                    sonidoTic();
                }
                ultimoGajo = gajo;
            }
        }
        frame = requestAnimationFrame(seguirRuleta);
    }

    function pararSeguimiento() {
        cancelAnimationFrame(frame);
        ultimoGajo = -1;
    }

    // NUEVO: botón silenciar
    document.getElementById("sonido").addEventListener("click", function () {
        sonidoActivo = !sonidoActivo;
        this.textContent = sonidoActivo ? "🔊 SONIDO" : "🔇 SILENCIO";
    });

    boton.addEventListener("click", function () {
        if (girando) {
            return;
        }
        girando = true;
        boton.disabled = true;

        // 3) NUEVO: activa el audio y suena el arranque
        activarAudio();
        sonidoInicio();

        fetch("juego/girar")
                .then(function (respuesta) {
                    return respuesta.json();
                })
                .then(function (datos) {
                    let indice = 0;
                    items.forEach(function (li, i) {
                        if (li.dataset.nombre === datos.categoria) {
                            indice = i;
                        }
                    });

                    ruleta.addEventListener(
                            "transitionend",
                            function () {
                                // 4) NUEVO: al parar, corta los tics y suena el final
                                pararSeguimiento();
                                sonidoFin();
                                resultado.textContent = "CATEGORIA: " + datos.categoria;
                                setTimeout(function () {
                                    window.location.href = "juego/pregunta";
                                }, 1200);
                            },
                            { once: true }
                    );

                    const centro = indice * seg + seg / 2;
                    const desvio = (Math.random() - 0.5) * seg * 0.6;
                    const base = Math.ceil(giroActual / 360) * 360 + 360 * 5;
                    giroActual = base + (360 - centro) + desvio;
                    ruleta.style.transform = "rotate(" + giroActual + "deg)";

                    // 5) NUEVO: arranca el seguimiento de los gajos
                    seguirRuleta();
                })
                .catch(function () {
                    resultado.textContent = "ERROR, INTENTA DE NUEVO";
                    boton.disabled = false;
                    girando = false;
                });
    });
</script>