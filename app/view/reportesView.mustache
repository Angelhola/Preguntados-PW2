<div class="lobby-barra">
    <span class="subtitulo-arcade" style="margin:0">ADMIN</span>
    <a class="lobby-mini" href="evento/lobby">VOLVER</a>
</div>

<h1 class="titulo-arcade">PREGUNTAS REPORTADAS</h1>

{{^hayPreguntas}}
    <p class="subtitulo-arcade">NO HAY PREGUNTAS CON 3 O MAS REPORTES</p>
{{/hayPreguntas}}

{{#preguntas}}
    <div class="tarjeta-arcade" id="pregunta-{{id}}" style="margin-bottom:16px">
        <p>{{texto}}</p>
        <span>{{categoria}} - {{reportes}} reportes - Correcta: {{opcion_correcta}}</span>
        <p style="font-size:12px">Motivos: {{motivos}}</p>
        <button class="boton-arcade btn-baja" data-id="{{id}}">DAR DE BAJA</button>
    </div>
{{/preguntas}}

<script>
    document.querySelectorAll(".btn-baja").forEach(function (boton) {
        boton.addEventListener("click", function () {
            if (!confirm("¿Dar de baja esta pregunta?")) {
                return;
            }
            const datos = new URLSearchParams();
            datos.append("id", boton.dataset.id);
            fetch("juego/darDeBaja", { method: "POST", body: datos })
                    .then(function (respuesta) {
                        return respuesta.json();
                    })
                    .then(function (resultado) {
                        if (resultado.ok) {
                            document.getElementById("pregunta-" + boton.dataset.id).remove();
                        }
                    });
        });
    });
</script>