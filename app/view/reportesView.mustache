<div class="lobby-barra">
    <span class="subtitulo-arcade" style="margin:0">EDITOR: {{usuario}}</span>
    <a class="lobby-mini" href="editor/panel">VOLVER</a>
</div>

<h1 class="titulo-arcade">PREGUNTAS REPORTADAS</h1>

{{^hayPreguntas}}
    <p class="subtitulo-arcade">NO HAY PREGUNTAS CON 3 O MAS REPORTES</p>
{{/hayPreguntas}}

{{#preguntas}}
    <div class="tarjeta-arcade" id="pregunta-{{id}}" style="margin-bottom:16px">
        <p>{{texto}}</p>
        <span>{{categoria}} - {{reportes}} reportes - Correcta: {{opcion_correcta}}</span>
        <p style="font-size:12px">Motivos: {{motivos}}</p>
        <button class="boton-arcade btn-resolver" data-id="{{id}}" data-accion="bloquear">BLOQUEAR</button>
        <button class="boton-arcade btn-resolver" data-id="{{id}}" data-accion="descartar">DESCARTAR</button>
    </div>
{{/preguntas}}

<script>
    let total = Number("{{total}}");

    document.querySelectorAll(".btn-resolver").forEach(function (boton) {
        boton.addEventListener("click", function () {
            const bloquear = boton.dataset.accion === "bloquear";
            if (!confirm(bloquear ? "¿Bloquear esta pregunta?" : "¿Descartar los reportes y mantenerla?")) {
                return;
            }
            const datos = new URLSearchParams();
            datos.append("id", boton.dataset.id);
            datos.append("accion", boton.dataset.accion);
            fetch("editor/resolverReporte", { method: "POST", body: datos })
                    .then(r => r.json())
                    .then(function (res) {
                        if (!res.ok) return;
                        document.getElementById("pregunta-" + boton.dataset.id).remove();
                        total--;
                        if (total === 0) location.reload(); // para mostrar el mensaje "no hay preguntas"
                    });
        });
    });

    // Cada 15 s pregunta cuántas hay; si cambió, recarga para mostrar las nuevas
    setInterval(function () {
        fetch("editor/cantidadReportes")
                .then(r => r.json())
                .then(function (j) { if (j.cantidad !== total) location.reload(); });
    }, 15000);
</script>