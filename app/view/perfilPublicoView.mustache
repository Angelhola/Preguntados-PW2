<div class="tarjeta-arcade perfil">
    <div class="perfil-cabecera">
        <div class="perfil-avatar">?</div>
        <div>
            <h2>{{usuario}}</h2>
            {{#region}}
                <div class="perfil-ubicacion">📍 {{region}}, {{pais}}</div>
            {{/region}}
        </div>
    </div>

    <h3>ESTADISTICAS</h3>
    <div>PARTIDAS: {{partidas}}</div>
    <div>ACIERTOS: 0%</div>

    <h3>LOGROS</h3>
    <details>
        <summary>1 / 5 DESBLOQUEADOS</summary>
        {{#logros}}
            <div class="logro {{estado}}">{{icono}} {{nombre}}</div>
        {{/logros}}
    </details>
    <br>

    <a class="lobby-mini" href="login/show">JUGAR / INGRESAR</a>
</div>