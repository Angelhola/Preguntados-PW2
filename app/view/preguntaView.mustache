<style>
    .tiempo-barra { width: 100%; max-width: 440px; height: 20px; border: 4px solid #fff; padding: 3px; box-sizing: border-box; margin: 0 auto 16px; }
    #barraTiempo { height: 100%; width: 100%; background: #00e5ff; transition: width 1s linear; }
    #barraTiempo.tiempo-poco { background: #ff0055; }
    #tiempo.alerta { color: #ff0055; animation: parpadeo 0.5s steps(1) infinite; }

    .continuar { text-align: center; margin-top: 16px; }
    .continuar-cartu { width: 96px; image-rendering: pixelated; filter: drop-shadow(0 0 6px #8a5cff); }
    .continuar-tiempo { font-size: 32px; color: #ffe600; margin: 8px 0 16px; }
    .continuar-botones { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
</style>

<div class="lobby-barra">
    <span class="subtitulo-arcade" style="margin:0">PUNTOS: <span id="puntos">{{puntos}}</span></span>
    <button id="btnReportar" class="lobby-mini">REPORTAR</button>
    <a class="lobby-mini" href="evento/lobby">VOLVER</a>
</div>
<span id="msgReporte" class="subtitulo-arcade"></span>
<div id="modalReporte" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.85); align-items:center; justify-content:center; z-index:99;">
    <div class="tarjeta-arcade" style="max-width:380px; width:90%; text-align:center;">
        <h2 class="subtitulo-arcade">REPORTAR PREGUNTA</h2>
        <select id="motivoReporte" style="padding:10px; font-family:inherit; width:100%; margin:12px 0; color:#000; background:#fff;">
            <option>Respuesta incorrecta</option>
            <option>Pregunta mal redactada</option>
            <option>Contenido ofensivo</option>
            <option>Otro</option>
        </select>
        <textarea id="detalleReporte" maxlength="200" rows="3" placeholder="Contanos más (obligatorio si elegís Otro)" style="padding:10px; font-family:inherit; width:100%; box-sizing:border-box; color:#000; background:#fff; margin-bottom:12px;"></textarea>
        <div class="continuar-botones">
            <button id="enviarReporte" class="boton-arcade">ENVIAR</button>
            <button id="cancelarReporte" class="boton-arcade">CANCELAR</button>
        </div>
    </div>
</div>

<p class="subtitulo-arcade">CATEGORIA: {{categoria}}</p>

<div class="tiempo-barra"><div id="barraTiempo"></div></div>
<p id="tiempo" class="subtitulo-arcade">TIEMPO: {{restante}}</p>

<h1 class="pregunta-texto">{{texto}}</h1>

<div class="opciones">
    {{#opciones}}
        <button class="opcion" data-indice="{{indice}}">{{texto}}</button>
    {{/opciones}}
</div>

<p id="mensaje" class="game-over" hidden></p>

<div id="continuar" class="continuar" hidden>
    <img src="public/img/cartu-triste.svg" class="continuar-cartu" alt="Cartu triste">
    <p class="game-over">¿QUERÉS CONTINUAR?</p>
    <p class="subtitulo-arcade">VIDA EXTRA: $50</p>
    <p id="continuar-tiempo" class="continuar-tiempo">10</p>
    <div class="continuar-botones">
        <button id="btnContinuar" class="boton-arcade">CONTINUAR ($50)</button>
        <button id="btnRendirse" class="boton-arcade">NO, GRACIAS</button>
    </div>
</div>

<a id="siguiente" class="boton-arcade" href="juego/ruleta" hidden>SIGUIENTE</a>

<script src="public/js/sonidos.js"></script>
<script>
    const TIEMPO_TOTAL = 20;
    const SEGUNDOS_CONTINUAR = 10;
    let restante = Number("{{restante}}");

    ["click", "keydown", "touchstart"].forEach(function (evento) {
        document.addEventListener(evento, activarAudio, { once: true });
    });
    activarAudio();

    const botones = document.querySelectorAll(".opcion");
    const siguiente = document.getElementById("siguiente");
    const puntos = document.getElementById("puntos");
    const mensaje = document.getElementById("mensaje");
    const barra = document.getElementById("barraTiempo");
    const textoTiempo = document.getElementById("tiempo");

    const panelContinuar = document.getElementById("continuar");
    const textoContinuar = document.getElementById("continuar-tiempo");
    const btnContinuar = document.getElementById("btnContinuar");
    const btnRendirse = document.getElementById("btnRendirse");
    let relojContinuar = null;
    let textoFinal = "";
    let respondido = false;


    const reloj = setInterval(function () {
        restante--;
        textoTiempo.textContent = "TIEMPO: " + restante;
        barra.style.width = (restante / TIEMPO_TOTAL * 100) + "%";

        if (restante <= 5 && restante > 0) {
            barra.classList.add("tiempo-poco");
            textoTiempo.classList.add("alerta");
            sonidoAlerta(restante);
        }
        if (restante <= 0) {
            responder(-1, null); // -1 = no contestó
        }
    }, 1000);
    function responder(indice, boton) {
        if (respondido) {
            return;
        }
        respondido = true;
        clearInterval(reloj);
        activarAudio();
        textoTiempo.classList.remove("alerta");

        const datos = new URLSearchParams();
        datos.append("opcion", indice);

        fetch("juego/responder", { method: "POST", body: datos })
                .then(function (respuesta) {
                    return respuesta.json();
                })
                .then(function (resultado) {
                    botones.forEach(function (b) {
                        b.disabled = true;
                    });
                    document
                            .querySelector('[data-indice="' + resultado.correcta + '"]')
                            .classList.add("opcion-correcta");
                    puntos.textContent = resultado.puntos;

                    if (resultado.acerto) {
                        sonidoCorrecto();
                        siguiente.hidden = false;
                        return;
                    }

                    if (boton) {
                        boton.classList.add("opcion-incorrecta");
                        sonidoIncorrecto();
                        textoFinal = "GAME OVER - HICISTE " + resultado.final + " PUNTOS";

                    } else {
                        sonidoTiempoAgotado();
                        textoFinal = "SE ACABÓ EL TIEMPO - HICISTE " + resultado.final + " PUNTOS";
                    }

                    if (resultado.puedeContinuar) {
                        ofrecerContinuar();
                    } else {
                        mostrarFinal();
                    }
                })
                .catch(function () {
                    respondido = false;
                });
    }

    barra.style.transition = "none";
    barra.style.width = (restante / TIEMPO_TOTAL * 100) + "%";
    void barra.offsetWidth;
    barra.style.transition = "";
    if (restante <= 5) {
        barra.classList.add("tiempo-poco");
        textoTiempo.classList.add("alerta");
    }
    if (restante <= 0) {
        responder(-1, null);
    }
    botones.forEach(function (boton) {
        boton.addEventListener("click", function () {
            responder(Number(boton.dataset.indice), boton);
        });
    });
    // ----- Vida extra -----

    function ofrecerContinuar() {
        let quedan = SEGUNDOS_CONTINUAR;
        textoContinuar.textContent = quedan;
        panelContinuar.hidden = false;

        relojContinuar = setInterval(function () {
            quedan--;
            textoContinuar.textContent = quedan;
            beep(880, 0, 0.08, "square", 0.08);
            if (quedan <= 0) {
                rendirse();
            }
        }, 1000);
    }

    function mostrarFinal() {
        panelContinuar.hidden = true;
        puntos.textContent = "0";
        mensaje.textContent = textoFinal;
        mensaje.hidden = false;
        siguiente.textContent = "JUGAR DE NUEVO";
        siguiente.hidden = false;
    }

    function rendirse() {
        clearInterval(relojContinuar);
        fetch("juego/terminar", { method: "POST" });
        mostrarFinal();
    }

    btnRendirse.addEventListener("click", rendirse);

    btnContinuar.addEventListener("click", function () {
        clearInterval(relojContinuar);
        btnContinuar.disabled = true;
        btnRendirse.disabled = true;

        fetch("juego/continuar", { method: "POST" })
                .then(function (respuesta) {
                    return respuesta.json();
                })
                .then(function (res) {
                    if (res.ok) {
                        window.location.href = "juego/ruleta";
                    } else {
                        rendirse();
                    }
                })
                .catch(function () {
                    rendirse();
                });
    });

    function sonidoAlerta(segundosRestantes) {
        if (segundosRestantes > 3) {
            // 5 y 4 segundos: un pitido firme
            beep(880, 0, 0.15, "square", 0.1);
        } else {
            // 3, 2 y 1 segundos: sirena de dos tonos
            beep(1100, 0, 0.12, "square", 0.13);
            beep(1500, 0.14, 0.12, "square", 0.13);
            beep(1100, 0.28, 0.12, "square", 0.13);
            beep(1500, 0.42, 0.12, "square", 0.13);
        }
    }

    const modal = document.getElementById("modalReporte");
    const btnReportar = document.getElementById("btnReportar");

    btnReportar.addEventListener("click", function () { modal.style.display = "flex"; });
    document.getElementById("cancelarReporte").addEventListener("click", function () { modal.style.display = "none"; });

    document.getElementById("enviarReporte").addEventListener("click", function () {
        const tipo = document.getElementById("motivoReporte").value;
        const detalle = document.getElementById("detalleReporte").value.trim();
        if (tipo === "Otro" && detalle === "") {
            document.getElementById("msgReporte").textContent = "Escribí el motivo";
            return;
        }
        const datos = new URLSearchParams();
        datos.append("motivo", detalle ? tipo + ": " + detalle : tipo);
        fetch("juego/reportar", { method: "POST", body: datos })
                .then(r => r.json())
                .then(r => {
                    document.getElementById("msgReporte").textContent = r.mensaje;
                    btnReportar.disabled = true;
                    modal.style.display = "none";
                });
    });
</script>