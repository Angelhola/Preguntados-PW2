
<h1 class="titulo-arcade">PLAYER 1</h1>
<p class="subtitulo-arcade">INGRESÁ TUS DATOS</p>

<div class="tarjeta-arcade">
    <form method="post" action="index.php?controller=login&method=login">
        <label for="usuario">USUARIO</label>
        <input type="text" name="usuario" id="usuario" autocomplete="off">

        <label for="password">CONTRASEÑA</label>
        <input type="password" name="password" id="password">

        {{#error}}
            <div class="game-over">
                <span class="parpadeo">GAME OVER</span><br>
                {{error}}
            </div>
        {{/error}}

        <button type="submit" class="boton-arcade">▶ START</button>
    </form>

    <a href="index.php?controller=login&method=register" class="link-arcade">
        <span class="parpadeo">PRESS</span> CREAR CUENTA NUEVA
    </a>
</div>
